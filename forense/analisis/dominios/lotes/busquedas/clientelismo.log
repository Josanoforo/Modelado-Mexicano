  -> 'beneficiario de programa|beneficiario social': 0 aciertos
  -> 'pension del bienestar|pension para adultos mayores': 5 aciertos -> ENUT2019/2024 P6_9_3 (tramito/cobro programa social)

python3 $U/u0busca.py -q "servidor de la nacion|servidores de la nacion" -q "programa social|programas sociales" -q "sembrando vida" -q "jovenes construyendo" -q "beca benito juarez|becas benito juarez" -q "secreto del voto|voto secreto" -q "identificacion partidista|identidad partidista" -q "aprobacion presidencial|aprueba al presidente" --limite 20
