  -> 'sembrando vida': 0
  -> 'jovenes construyendo': 19 aciertos (ENCUCI2020 AP6_9/AP6_10, ENIF2021/2024 P3_4, ENSAFI2023, ENASIC2022, ENUT2019/2024, CPV2020)
  -> 'beca benito juarez|becas benito juarez': 7 aciertos (ENIF2021/2024, ENSAFI2023)
  -> 'secreto del voto|voto secreto': 0 (texto compuesto no calza; ver AP7_15 abajo con termino simple)
  -> 'identificacion partidista|identidad partidista': 0
  -> 'aprobacion presidencial|aprueba al presidente': 0

python3 $U/u0busca.py -q "AP7_" -q "AP8_" --encuesta encuci2020 --limite 60
