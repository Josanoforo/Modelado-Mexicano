# Búsquedas crudas del lote 'genero' (ASTRA5-U0), sesión que completa el trabajo.
# El ejecutor previo de este mismo lote fue interrumpido antes de escribir salida;
# sus búsquedas (corpus + 12 consultas web, presupuesto del lote agotado) están en
# /tmp/claude-1000/-home-pc0/427b1d4d-1447-4998-92f5-de9c7e70504b/scratchpad/u0/previas/genero.log
# y se citan como "(ejecutor previo)" en busqueda_a13 de filas.tsv cuando se reutiliza
# un conteo. Presupuesto web del lote: 12/12 ya usado por el ejecutor previo (items
# [8]-[19] de previas/genero.log) → esta sesión NO hizo consultas web nuevas.

### [S1] u0mf --busca sesnsp/mcci/causa en comun/cepal/cuaderno28/wef/cgpj/milei/ministerio de las mujeres --limite 3
cd /home/pc0/mm-astra5-mapa-dominios-1
for t in "sesnsp" "informe de violencia" "mcci" "causa en comun" "cepal" "cuaderno 28" "wef" "world economic forum" "cgpj" "milei" "ministerio de las mujeres"; do
  python3 $U/u0mf.py --busca "$t" --limite 3
done
# resultado: sesnsp=0; informe de violencia=0; mcci=1 (mcci_encuesta_corrupcion_impunidad_2019_2024_xlsx,
#   ES OTRO DOCUMENTO: encuesta de percepción de corrupción, NO la investigación de feminicidios
#   con sentencias citada por el report — falso positivo por palabra clave); causa en comun=0;
#   cepal=0; cuaderno 28=0; wef=0; world economic forum=0; cgpj=0; milei=0;
#   ministerio de las mujeres=0.
# → confirma que ninguno de los documentos SESNSP/MCCI-feminicidio/Causa en Común/CEPAL/
#   WEF/CGPJ/Milei está en el manifiesto del corpus: son todos afirmaciones documentales
#   externas, no encuestas del corpus ASTRA5.

### [S2] u0busca ENUT cuidado de hijos/paternidad (variantes), sin filtro de ola
python3 $U/u0busca.py -q "cuido a mis hijos|cuidar a los hijos|atender a los hijos|bano a los ninos|dar de comer a los ninos" --encuesta enut --limite 15
# → 0 aciertos con texto de 314256 identidades revisadas, 113780 con texto (confirma lo ya
#   hallado por el ejecutor previo con otras variantes: previas/genero.log [5],[7],[21]: la
#   variable ENUT relevante es el bloque agregado TRAB_NO_REM_VOL, ya cubierto por el contrato
#   ASTRA5-U0-TIME-002, no reactivos individuales de "cuidar hijos" por nombre literal).

### [S3] u0mf --busca wvs / latinobarometro --limite 5
python3 $U/u0mf.py --busca wvs --limite 5
python3 $U/u0mf.py --busca latinobarometro --limite 5
# → wvs: 11 entradas (WVS7 México 2018: cuestionario, metodología, diseño muestral, equipo,
#   base v3.0 — en manifiesto, no abierto ni usado como evidencia de actitud de género en
#   este lote, ver genero-021).
# → latinobarometro: 9 entradas (Latinobarómetro 2024: cuestionario, fichas técnicas —
#   en manifiesto, no abierto en este lote).

### [S4] u0mf --busca endireh --busca 2021 --limite 5
python3 $U/u0mf.py --busca endireh --busca 2021 --limite 5
# → 46 entradas coinciden; confirmados en esta sesión: endireh2021_bd_csv_zip
