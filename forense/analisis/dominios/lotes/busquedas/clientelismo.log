python3 $U/u0mf.py --busca judicial --limite 30 -> 0 entradas (comprueba que los computos judiciales SCJN 2025 NO estan en el manifiesto)
python3 $U/u0mf.py --busca enem --limite 20 -> 1 entrada espuria (gen2_encrige2020_diseno_muestral, coincide solo por substring "enem" en "encrige"), NO es el Estudio Nacional Electoral de Mexico
python3 $U/u0mf.py --id ine_conteos_censales_participacion_2024 -> ficha completa leida (usado_para, nota de adquisicion MAESTRA33-A3, fecha_descarga 2026-09-01)
python3 $U/u0mf.py --busca servidor --busca nacion --limite 20 -> 0 entradas (dentro de la corrida combinada de u0busca ya reportada arriba)
python3 $U/u0mf.py --calc mexico_lapop_americasbarometer_2019_v1_0_w --limite 20
