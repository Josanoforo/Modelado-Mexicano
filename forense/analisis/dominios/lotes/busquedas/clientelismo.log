       clien1n = "A un conocido le ofrecieron beneficio por su voto (última elección nacional)"
       clien1na = "Le ofrecieron un beneficio por su voto en la última elección generales"

python3 $U/u0busca.py -q "compra de voto|comprar el voto" -q "dadiva|dadivas" -q "beneficiario de programa|beneficiario social" -q "pension del bienestar|pension para adultos mayores" --limite 30
