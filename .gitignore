# ACTO MAESTRA34-N7 · SKILLS-COLA-Y-ADQ: log fechado del cron de
# adquisición (tools/adquiere_cron.sh) -- de la caja, no del repo.
forense/adq-log/
# ACTO GEN2-RUTINA-DERIVADOS-1: log/heartbeat/lock del cron de
# derivación (tools/deriva_cron.sh) -- directorio propio, nunca
# forense/adq-log/, para no colisionar con el lock de adquisición.
forense/deriva-log/
# MAESTRA37-INFRA-1 Frente B (COMMIT-2): lock runtime de tests/manifiesto.py
# -- puramente de ejecución local, nunca versionado.
data/.manifiesto.lock
# Cache local del extractor incremental de contexto de reactivos. La clave
# incluye sha256 de la fuente + version del extractor; no es evidencia ni
# producto publicable.
data/.reactivos-contexto-cache/
# MAESTRA37-INFRA-1 Frente C (COMMIT-3): lock runtime de alta_relacion.py
# sobre data/curacion-registro/ -- puramente de ejecución local.
data/curacion-registro/.alta-relacion.lock
# GEN2-ADQUIERE-ENVIPE2026-ENIGH2024-1: lock runtime de
# tools/curador_registro/tsv_crudo.py::bloqueo_escritura sobre el registro
# de cola -- puramente de ejecución local, nunca versionado.
data/curacion-registro/cola-adquisicion-registro.tsv.lock
# MAESTRA37-INFRA-1 Frente C (COMMIT-3): journal de cada alta transaccional
# (tools/curador_registro/alta_relacion.py) -- artefacto de ejecución, uno
# por relacion_id, no versionado por defecto.
data/alta-relacion-journal-*.json
