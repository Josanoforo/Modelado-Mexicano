.bashrc
# ACTO MAESTRA32-E19 · SELLA-CAMINO-1 (D-10, 31/ago/2026): la skill /acto
# vive en .claude/commands/, repo-side y versionada -- el resto de .claude/
# (settings locales, estado de sesión) sigue ajeno al repo, sin trackear.
# ACTO SESSION-START-HOOK-CLAUDE-MD (20/sep/2026): .claude/settings.json
# también se versiona -- es el hook SessionStart compartido, no un ajuste
# local; settings.local.json sigue sin trackear.
.claude/*
!.claude/commands/
!.claude/settings.json
