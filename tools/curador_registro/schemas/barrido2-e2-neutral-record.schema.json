{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "barrido2-e2-neutral-record.schema.json",
  "title": "BARRIDO-2 private neutral E2 record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_id", "record_sha256", "batch_id", "batch_sha256",
    "payload_id", "representacion_id", "sha256", "objeto_logico_id", "root_id",
    "ruta_relativa", "format", "depth", "localizador", "objeto_tipo", "nombre",
    "etiqueta", "texto_reactivo", "definicion", "categorias", "value_labels",
    "unidad", "periodo", "poblacion", "pagina", "hoja", "tabla",
    "objeto_padre_id", "relacion_estructural", "frontera_inspeccion", "parser",
    "parser_version", "estado", "privacidad", "fecha"
  ],
  "properties": {
    "schema_version": {"const": "BARRIDO2-E2-1.0"},
    "record_id": {"type": "string", "pattern": "^E2R-[0-9a-f]{64}$"},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "batch_id": {"type": "string", "pattern": "^E2B-[0-9a-f]{64}$"},
    "batch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload_id": {"type": "string", "minLength": 1},
    "representacion_id": {"type": "string", "pattern": "^REP-[0-9a-f]{64}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "objeto_logico_id": {"type": "string", "pattern": "^OBJ-B2-[0-9a-f]{64}$"},
    "root_id": {"enum": ["data_raw", "descargas_mx"]},
    "ruta_relativa": {"type": "string", "minLength": 1},
    "format": {"type": "string", "minLength": 1},
    "depth": {"type": "integer", "minimum": 0},
    "localizador": {"type": "string", "minLength": 1},
    "objeto_tipo": {"type": "string", "minLength": 1},
    "nombre": {"type": "string"},
    "etiqueta": {"type": "string"},
    "texto_reactivo": {"type": "string"},
    "definicion": {"type": "string"},
    "categorias": {"type": "array", "items": {"type": "string"}},
    "value_labels": {"type": "array", "items": {"type": "string"}},
    "unidad": {"type": "string"},
    "periodo": {"type": "string"},
    "poblacion": {"type": "string"},
    "pagina": {"type": ["integer", "string"]},
    "hoja": {"type": "string"},
    "tabla": {"type": "string"},
    "objeto_padre_id": {"type": "string"},
    "relacion_estructural": {"type": "string"},
    "frontera_inspeccion": {"type": "string", "minLength": 1},
    "parser": {"type": "string", "minLength": 1},
    "parser_version": {"type": "string", "minLength": 1},
    "estado": {"enum": ["E2-COMPLETO", "EXCEPCION-ESPECIFICA"]},
    "privacidad": {"enum": ["DEPURADO", "[REDACTADO-PRIVACIDAD]"]},
    "fecha": {"type": "string", "format": "date"}
  },
  "not": {
    "anyOf": [
      {"required": ["necesidad_id"]},
      {"required": ["relacion_id"]},
      {"required": ["clasificacion_relacion"]},
      {"required": ["constructo_esperado"]},
      {"required": ["valor_individual"]},
      {"required": ["fila_microdato"]},
      {"required": ["pii"]}
    ]
  }
}
