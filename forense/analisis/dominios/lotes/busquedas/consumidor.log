# busquedas.log -- lote consumidor (ASTRA5-U0)
# Ejecutor: esta sesion, 2026-09-24. Continua un ejecutor previo interrumpido antes de
# escribir salida; sus comandos y resultados crudos estan en
# /tmp/claude-1000/-home-pc0/427b1d4d-1447-4998-92f5-de9c7e70504b/scratchpad/u0/previas/consumidor.log
# (23 bloques de comandos u0busca/u0pdf/u0mf + 12 WebSearch, del mismo corpus/herramientas).
# Este archivo registra SOLO los comandos corridos por ESTA sesion (no repite el contenido
# de previas/consumidor.log; se cita puntualmente en busqueda_a13 de filas.tsv cuando se
# reutiliza un conteo, marcado "(ejecutor previo)").
#
# PRESUPUESTO WEB DEL LOTE: 12 consultas maximo (WebSearch+WebFetch). El ejecutor previo
# ya agoto las 12 en este mismo paquete (ver previas/consumidor.log, bloques [11]-[22]).
# Esta sesion NO realizo ninguna consulta web nueva; todo lo que exigia web y no estaba ya
# cubierto por el ejecutor previo quedo en PENDIENTE-VERIFICACION-DOCUMENTAL con la razon
# "presupuesto de busqueda web del lote agotado por el ejecutor previo".

U=/tmp/claude-1000/-home-pc0/427b1d4d-1447-4998-92f5-de9c7e70504b/scratchpad/u0

### banxico (listado completo, para localizar RIB tarjetas de credito / MSI y CoDi)
python3 $U/u0mf.py --busca "banxico" --limite 60
# -> 31/1680 entradas: SPEI (CF881-891), CoDi avances, informes IdMF, encuestas de
#    competencias financieras 2019/2021/2024, satisfaccion de usuarios 2019-2024,
#    IMOR producto 2026T1, banxico_2013_17_crowding_out_70ymas. NINGUNA es el RIB
#    "Indicadores Basicos de Tarjetas de Credito" (la serie que sustenta el MSI 20%).

### condusef (listado completo)
python3 $U/u0mf.py --busca "condusef" --limite 60
# -> 30/1680 entradas: datos abiertos CONDUSEF (acciones de defensa, indice de
#    reclamaciones, instituciones mas reclamadas, sanciones, educacion financiera,
#    REDECO/REUNE, unidades especializadas). No se uso directamente en ninguna fila de
#    este report (no citado por el texto del report consumidor), pero se dejo registrado
#    para contexto de U0-DINERO.

### enigh2024_reporte_resultados_pdf -- brecha regional CDMX/Chiapas
python3 $U/u0pdf.py -q "Chiapas" --id enigh2024_reporte_resultados_pdf --contexto 300 --limite 5
# -> 12 coincidencias; p.22-23 dan ingreso corriente promedio trimestral por hogar
#    (Guerrero/Chiapas mas bajos, Nuevo Leon/CDMX mas altos) -- NO es la cifra de gasto.

python3 $U/u0pdf.py -q "alimentos, bebidas y tabaco" --id enigh2024_reporte_resultados_pdf --contexto 300 --limite 6
# -> 14 coincidencias; confirma 37.7% del gasto corriente monetario en alimentos, bebidas
#    y tabaco en 2024 (p.15-19), rubro principal.

python3 $U/u0pdf.py -q "22 128|22128|22,128" --id enigh2024_reporte_resultados_pdf --contexto 200 --limite 5
# -> 0 coincidencias (la cifra "mensual" del report NO aparece literal en el documento).

python3 $U/u0pdf.py -q "9 039|9039|9,039" --id enigh2024_reporte_resultados_pdf --contexto 200 --limite 5
# -> 0 coincidencias (idem para Chiapas).

python3 $U/u0pdf.py -q "ciudad de mexico" --id enigh2024_reporte_resultados_pdf --contexto 250 --limite 8
# -> 12 coincidencias; p.23 da el dato correcto: "en la enigh 2024, ciudad de mexico y
#    queretaro registraron el mayor gasto corriente monetario promedio trimestral por
#    hogar, con 66 383 y 61 593 pesos". CDMX/3 = 22 127.7 ~ $22,128 (coincide con el report).

python3 $U/u0pdf.py -q "chiapas y oaxaca reportaron los gastos" --id enigh2024_reporte_resultados_pdf --contexto 400 --limite 3
# -> 1 coincidencia; "en 2024, chiapas registro 27 118 pesos". 27118/3 = 9039.3 ~ $9,039
#    (coincide exactamente con el report). Ratio 66383/27118 = 2.448 ~ "2.5 veces" (coincide).
#    CONCLUSION: el report deriva su cifra "mensual" de gasto corriente monetario TRIMESTRAL
#    por hogar de ENIGH 2024 dividido entre 3, sin declarar esa operacion; es MEDIBLE-EN-CORPUS
#    (fila consumidor-023).

